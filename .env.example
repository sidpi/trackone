# ─────────────────────────────────────────────────────────────
# ShipTrack — environment variables
# Copy this file to `.env.local` for local development and fill
# in the values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────
# Find these in the Supabase Dashboard → Project Settings → API.
# Use the hosted project URL (https://xxxx.supabase.co) or the
# local CLI URL (http://127.0.0.1:54321) when using `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Site (optional but recommended) ─────────────────────────
# Used to build absolute URLs (auth callback redirects etc.).
# On Cloudflare use your custom domain: https://track.sidcandev.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Courier tracking (Track 3) ────────────────────────────
# Priority: INDIAN_COURIER_API_URL (if set) → AFTERSHIP_API_KEY → mock.

# URL of your self-hosted indian-courier-api scraper service
# (github.com/rajatdhoot123/indian-courier-api). Host it separately — it
# needs a Chromium-capable runtime and cannot run on Cloudflare Workers.
# Example: https://your-tracking-service.example.com
INDIAN_COURIER_API_URL=

# AfterShip Tracking API key — SERVER-ONLY secret, never expose to the
# client. Get one at https://www.aftership.com (free tier available).
# Used when INDIAN_COURIER_API_URL is not set.
AFTERSHIP_API_KEY=

# How long a successful tracking refresh is cached before hitting the
# courier API again (minutes). Defaults to 15.
TRACKING_CACHE_TTL_MINUTES=15

# ── Cloudflare / OpenNext (needed for preview & deploy) ─────
# `npm run preview` and `npm run deploy` read runtime variables
# from a `.dev.vars` file (local) or Worker environment variables
# (production) — see README "Deployment".
# NEXT_PUBLIC_* values above are inlined at build time, so they
# must also be available in the build environment (CI variables
# or the shell running the build).
