# ─────────────────────────────────────────────────────────────
# ShipTrack — environment variables
# Copy this file to `.env.local` for local development and fill
# in the values. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ─────────────────────────────────────
# Find these in the Supabase Dashboard → Project Settings → API.
# Use the hosted project URL (https://xxxx.supabase.co) or the
# local CLI URL (http://127.0.0.1:54321) when using `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Site (optional but recommended) ─────────────────────────
# Used to build absolute URLs (auth callback redirects etc.).
# On Cloudflare use your custom domain: https://track.sidcandev.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Courier tracking (Track 3) ────────────────────────────
# Provider priority when multiple are set:
#   TrackCourier → Ship24 → indian-courier-api (scraper) → mock
#
# TrackCourier.io — https://api.trackcourier.io (X-API-Key header).
# Free tier: 100 requests/month. SERVER-ONLY secret.
TRACKCOURIER_API_KEY=

# Ship24 — https://docs.ship24.com (Authorization: Bearer).
# Per-shipment plan. SERVER-ONLY secret.
SHIP24_API_KEY=

# Self-hosted indian-courier-api scraper (optional; see README — currently
# broken against AfterShip's redesigned site).
INDIAN_COURIER_API_URL=

# How long a successful tracking refresh is cached before hitting the
# provider again (minutes). Defaults to 15.
TRACKING_CACHE_TTL_MINUTES=15

# ── Email discovery (Track 4) ───────────────────────────────
# Google Cloud OAuth client for Gmail read-only access.
# https://console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID (Web application).
# Authorized redirect URI:
#   {NEXT_PUBLIC_SITE_URL}/api/emails/callback
#   e.g. http://localhost:3000/api/emails/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Key used to encrypt OAuth refresh tokens at rest (AES-256-GCM).
# Must be 32 bytes encoded as base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SERVER-ONLY secret — never commit it.
EMAIL_TOKEN_ENCRYPTION_KEY=

# ── Cloudflare / OpenNext (needed for preview & deploy) ─────
# `npm run preview` and `npm run deploy` read runtime variables
# from a `.dev.vars` file (local) or Worker environment variables
# (production) — see README "Deployment".
# NEXT_PUBLIC_* values above are inlined at build time, so they
# must also be available in the build environment (CI variables
# or the shell running the build).
